# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local to git.
# The capstone uses its own services. Never point these at the Week 14 ones.

OPENAI_API_KEY=sk-...
# Optional. Defaults to gpt-4o-mini (lib/model.ts).
# CHAT_MODEL=gpt-4o-mini

# Upstash Vector: the capstone index (1536 dimensions, COSINE).
# lib/seed.ts refuses to run against the Week 14 index.
UPSTASH_VECTOR_REST_URL=https://...-vector.upstash.io
UPSTASH_VECTOR_REST_TOKEN=...

# Upstash Redis: session memory, tickets, caches.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Langfuse: traces. Base URL is https://cloud.langfuse.com (EU)
# or https://us.cloud.langfuse.com (US).
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Optional: email alert to sales when a client leaves contact details on a
# ticket (app/api/tickets/[id]/contact). Unset = the route logs email=skipped.
# The email holds the ticket id and reason only, never client details.
# RESEND_API_KEY=re_...
# SALES_ALERT_EMAIL=sales@example.com
# SALES_ALERT_FROM=CTI Advisor <onboarding@resend.dev>

# Test switches only. Never set them in Vercel.
# SIMULATE_VECTOR_FAILURE=1   searchProducts uses the exact-match fallback (degraded: true)
# SESSION_KEY_PREFIX=test:    session keys for the Redis tests
# TICKET_KEY_PREFIX=test:     ticket keys for the Redis tests and grade.ts
# FORCE_UNGROUNDED=1          the answer guard fails every draft: one rewrite, then the sales fallback (M7)
# NEXT_DIST_DIR=.next-m7      build folder for a second dev server in this folder (next.config.mjs)

# Evaluation (M6). PROMPT_VARIANT picks the system prompt: v1, v2 or v3 (default v1).
# JUDGE_MODEL is the RAGAS and explanation judge (default gpt-4o). The chat model stays CHAT_MODEL.
# PROMPT_VARIANT=v1
# JUDGE_MODEL=gpt-4o
